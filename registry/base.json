[
  {
    "name": "ascii-tokens",
    "type": "registry:item",
    "title": "Dither tokens",
    "description": "CSS variables every asciicn piece reads: ink, paper, cell size, bloom strength and the named colour palette (blue, purple, green, pink, orange, red, grey), tuned for light and dark.",
    "cssVars": {
      "theme": {
        "color-ascii-ink": "var(--ascii-ink)",
        "color-ascii-paper": "var(--ascii-paper)",
        "color-dither-blue": "var(--ascii-color-blue)",
        "color-dither-purple": "var(--ascii-color-purple)",
        "color-dither-green": "var(--ascii-color-green)",
        "color-dither-pink": "var(--ascii-color-pink)",
        "color-dither-orange": "var(--ascii-color-orange)",
        "color-dither-red": "var(--ascii-color-red)",
        "color-dither-grey": "var(--ascii-color-grey)"
      }
    },
    "css": {
      "@layer base": {
        ":root": {
          "--ascii-ink": "var(--primary)",
          "--ascii-paper": "var(--background)",
          "--ascii-cell": "3px",
          "--ascii-color-blue": "oklch(0.56 0.18 248)",
          "--ascii-color-purple": "oklch(0.53 0.22 302)",
          "--ascii-color-green": "oklch(0.58 0.15 152)",
          "--ascii-color-pink": "oklch(0.58 0.21 355)",
          "--ascii-color-orange": "oklch(0.64 0.17 52)",
          "--ascii-color-red": "oklch(0.55 0.21 27)",
          "--ascii-color-grey": "oklch(0.55 0 0)",
          "--ascii-bloom": "0.6"
        },
        ".dark": {
          "--ascii-ink": "var(--primary)",
          "--ascii-paper": "var(--background)",
          "--ascii-cell": "3px",
          "--ascii-color-blue": "oklch(0.72 0.14 240)",
          "--ascii-color-purple": "oklch(0.7 0.18 304)",
          "--ascii-color-green": "oklch(0.78 0.17 152)",
          "--ascii-color-pink": "oklch(0.74 0.17 354)",
          "--ascii-color-orange": "oklch(0.79 0.15 62)",
          "--ascii-color-red": "oklch(0.68 0.2 25)",
          "--ascii-color-grey": "oklch(0.66 0 0)",
          "--ascii-bloom": "1"
        }
      }
    }
  },
